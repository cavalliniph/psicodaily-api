SECRET_KEY=sua-chave-secreta

# Dev: caminho absoluto do .FDB local. Docker/Northflank: /data/BANCO.FDB (volume), que e o padrao do entrypoint
DB_DATABASE=caminho-do-banco
DB_HOST=localhost
DB_USER=usuario-do-banco
DB_PASSWORD=senha-do-banco
DB_CHARSET=UTF8
# So no primeiro boot de um ambiente novo: o entrypoint cria o banco vazio se ele nao existir
# CRIAR_BANCO=1

CLIENT_ID=seu-client-id-arkhe
CLIENT_SECRET=seu-secret-arkhe

# Cloudflare R2 (fotos de perfil no bucket publico, arquivos do chat no privado; o token precisa dos dois)
ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
ACCESS_KEY_ID=sua-access-key-r2
SECRET_ACCESS_KEY=sua-secret-key-r2
R2_PUBLIC_URL=https://pub-b6945a8ffa914112b679b4f615712e92.r2.dev
R2_BUCKET_PRIVADO=psicodaily-objects

# Front usado nos links dos e-mails (ex.: aviso de entrada na sala)
FRONT_URL=https://psicodaily-front.vercel.app

# Assistente de IA (POST /api/assistente): chave gratuita em console.groq.com
GROQ_API_KEY=sua-chave-groq
